# Leave both empty to run in DEMO mode (in-browser simulated data, no backend needed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Web Push public key (pair with VAPID_PRIVATE_KEY in Edge Function secrets)
VITE_VAPID_PUBLIC_KEY=
# Optional: street-map tiles for the fleet map. Default is OpenStreetMap.
# Set to "off" to use only the built-in map of Armenia (works offline, no external requests).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
